[
 {
  "id": "0914-am",
  "at": "2026-09-14T07:30:00",
  "platforms": [
   "x",
   "threads"
  ],
  "image": "images/0914-am.png",
  "text": "「いい人」をやめた日から、私は私に戻れた。今日は、自分の気持ちを1番にしていい。"
 },
 {
  "id": "0914-x10",
  "at": "2026-09-14T10:00:00",
  "platforms": [
   "x"
  ],
  "text": "「頑張れば報われる」を信じて、心が壊れた。今は「頑張らない仕組み」を作ってる。"
 },
 {
  "id": "0914-pm",
  "at": "2026-09-14T12:15:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "褒められたら「そんなことないです」って打ち消してた私。今は「ありがとう」で止める練習中。受け取るって、練習でできるようになる。"
 },
 {
  "id": "0914-x18",
  "at": "2026-09-14T18:30:00",
  "platforms": [
   "x"
  ],
  "text": "自己肯定感が低い人ほど、頑張り屋。だから、まず休んでいい。"
 },
 {
  "id": "0914-ev",
  "at": "2026-09-14T21:00:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "面倒なことは、AIに任せた。空いた時間で、お茶を飲んだ。手抜きは、自分を大切にすること。"
 },
 {
  "id": "0915-am",
  "at": "2026-09-15T07:30:00",
  "platforms": [
   "x",
   "threads"
  ],
  "image": "images/0915-am.png",
  "text": "お金の不安って、金額よりも「正体が見えないこと」から来る。まず、見るのがこわい口座を、1回だけ開く。"
 },
 {
  "id": "0915-x10",
  "at": "2026-09-15T10:00:00",
  "platforms": [
   "x"
  ],
  "text": "手取り20万・貯金ゼロ。そこから最初にやったのは、家計簿でも副業でもなく「通帳を見る勇気」だった。"
 },
 {
  "id": "0915-pm",
  "at": "2026-09-15T12:15:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "「お金がない」が口ぐせだった頃、毎日通帳を見てはため息ついてた。今は、払うとき「ありがとう」って言ってる。同じお金でも、心が違う。"
 },
 {
  "id": "0915-x18",
  "at": "2026-09-15T18:30:00",
  "platforms": [
   "x"
  ],
  "text": "私がどん底から『自分に還った』話、Noteに全部書きました。プロフィールのリンクから読めます。"
 },
 {
  "id": "0915-ev",
  "at": "2026-09-15T21:00:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "全部ひとりで抱えてた私へ。「あれ取って」って言えるようになるだけで、世界は少しやさしくなる。"
 },
 {
  "id": "0916-am",
  "at": "2026-09-16T07:30:00",
  "platforms": [
   "x",
   "threads"
  ],
  "image": "images/0916-am.png",
  "text": "自分を後回しにしてるサイン：断れない／頼れない／無理に笑う。ひとつでも当てはまったら、あなたは頑張りすぎ。"
 },
 {
  "id": "0916-x10",
  "at": "2026-09-16T10:00:00",
  "platforms": [
   "x"
  ],
  "text": "「私なんて」が口ぐせの人へ。その言葉、誰に教わった？"
 },
 {
  "id": "0916-pm",
  "at": "2026-09-16T12:15:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "母からもらうものは受け取れるのに、他人からだと「私なんかが」って思ってた。受け取り下手は、自己価値とつながってる。"
 },
 {
  "id": "0916-x18",
  "at": "2026-09-16T18:30:00",
  "platforms": [
   "x"
  ],
  "text": "AIに任せたら、1日2時間の『面倒』が消えた。その2時間で、自分の機嫌をとってる。"
 },
 {
  "id": "0916-ev",
  "at": "2026-09-16T21:00:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "今日、AIに「頭の中のモヤモヤ」を全部書き出してもらった。整理されると、不安って小さくなる。"
 },
 {
  "id": "0917-am",
  "at": "2026-09-17T07:30:00",
  "platforms": [
   "x",
   "threads"
  ],
  "image": "images/0917-am.png",
  "text": "望みは、言葉にしないと動き出さない。「私なんて」で飲み込んできた望み、今日ひとつだけ口に出してみる。"
 },
 {
  "id": "0917-x10",
  "at": "2026-09-17T10:00:00",
  "platforms": [
   "x"
  ],
  "text": "彼に旅行に連れて行ってもらうのに「この人の懐、大丈夫かな」って心配してた私。受け取り下手は、ここまで根が深い。"
 },
 {
  "id": "0917-pm",
  "at": "2026-09-17T12:15:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "美容にお金を使うとき、昔は罪悪感。今は「これで私はもっと美しくなる、嬉しい」。同じ金額、違う心。"
 },
 {
  "id": "0917-x18",
  "at": "2026-09-17T18:30:00",
  "platforms": [
   "x"
  ],
  "text": "自分軸・お金・AIの話、まとめてNoteに。読むだけで一歩軽くなるように書いた。プロフのリンクから。"
 },
 {
  "id": "0917-ev",
  "at": "2026-09-17T21:00:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "頑張らなくていい。面倒はAIに任せていい。それで浮いた時間が、あなたの人生。"
 },
 {
  "id": "0918-am",
  "at": "2026-09-18T07:30:00",
  "platforms": [
   "x",
   "threads"
  ],
  "image": "images/0918-am.png",
  "text": "「私は存在してるだけで価値がある」。最初は棒読みだった。何度も言ってたら、少しずつ本当になってきた。"
 },
 {
  "id": "0918-x10",
  "at": "2026-09-18T10:00:00",
  "platforms": [
   "x"
  ],
  "text": "昔の私：全部ひとりで抱える。今の私：面倒はAI、気持ちは自分で。"
 },
 {
  "id": "0918-pm",
  "at": "2026-09-18T12:15:00",
  "platforms": [
   "x",
   "threads"
  ],
  "image": "images/0918-pm.png",
  "text": "会社員の私が、もっと早く知りたかったAIの使い方：①モヤモヤを整理してもらう ②面倒な文章の下書き ③1日の段取り。全部、5分。"
 },
 {
  "id": "0918-x18",
  "at": "2026-09-18T18:30:00",
  "platforms": [
   "x"
  ],
  "text": "「出したお金は巡って戻る」と思って払うようになってから、お金がこわくなくなった。気の持ちようで、行動が変わる。"
 },
 {
  "id": "0918-ev",
  "at": "2026-09-18T21:00:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "自立の最初の一歩は、地味だった。家計簿、副業を調べる、積立を自動に。大きなことじゃなくていい。"
 },
 {
  "id": "0919-am",
  "at": "2026-09-19T07:30:00",
  "platforms": [
   "x",
   "threads"
  ],
  "image": "images/0919-am.png",
  "text": "気を遣うのは、本当は好きじゃなかった。家庭環境で染みついてただけ。染みついたものは、ほどける。"
 },
 {
  "id": "0919-x10",
  "at": "2026-09-19T10:00:00",
  "platforms": [
   "x"
  ],
  "text": "自立って、誰にも頼らないことじゃない。頼る相手を、自分で選べること。"
 },
 {
  "id": "0919-pm",
  "at": "2026-09-19T12:15:00",
  "platforms": [
   "x",
   "threads"
  ],
  "image": "images/0919-pm.png",
  "text": "AIに任せる前の私：全部抱えて疲弊、時間ゼロ。任せた後：自分の時間、気持ちを優先。変わったのは能力じゃなく、任せ方。"
 },
 {
  "id": "0919-x18",
  "at": "2026-09-19T18:30:00",
  "platforms": [
   "x"
  ],
  "text": "自分を後回しにしてきた人へ。私の実話と、今日からできる小さな一歩をNoteに書いてます。プロフのリンクから。"
 },
 {
  "id": "0919-ev",
  "at": "2026-09-19T21:00:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "息を吐くと、その息は空気と交わって、窓の外へ、空へ。私はいつも、大きなものとつながってる。そう思うと、こわくなくなる。"
 },
 {
  "id": "0920-am",
  "at": "2026-09-20T07:30:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "今週、自分を大切にできた瞬間を1つ思い出す。それが、来週のあなたを作る。"
 },
 {
  "id": "0920-x10",
  "at": "2026-09-20T10:00:00",
  "platforms": [
   "x"
  ],
  "text": "気を遣って生きてきた家庭で育った人は、「本当はどうしたい？」に答えるのが一番苦手。まずそこから。"
 },
 {
  "id": "0920-pm",
  "at": "2026-09-20T12:15:00",
  "platforms": [
   "x",
   "threads"
  ],
  "text": "「手抜きは、スキルです」。面倒くさがりでも、AIがいれば動ける。私がそうだったから。"
 },
 {
  "id": "0920-x18",
  "at": "2026-09-20T18:30:00",
  "platforms": [
   "x"
  ],
  "text": "今週、自分の気持ちを1回でも優先できた人。それ、ちゃんと前進です。"
 },
 {
  "id": "0920-ev",
  "at": "2026-09-20T21:00:00",
  "platforms": [
   "x",
   "threads"
  ],
  "image": "images/0920-ev.png",
  "text": "おやすみ前に。自分の気持ちを、優先していい。それだけ、覚えて眠って。"
 }
]
